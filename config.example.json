{
  "screen": {
    "type": "geekmagic",
    "host": "192.168.1.4",
    "port": 80,
    "timeout": 10,
    "brightness": 85,
    "min_upload_interval_seconds": 300
  },
  "display": {
    "mode": "summary",
    "carousel_page_duration_seconds": 10
  },
  "avatar": {
    "name": "",
    "status": "auto",
    "action": "auto",
    "animated": true,
    "fps": 8,
    "metric": "remaining"
  },
  "polling": {
    "refresh_interval_seconds": 15,
    "retry_delay_seconds": 10
  },
  "providers": {
    "claude": {
      "enabled": true
    },
    "codex": {
      "enabled": true
    },
    "antigravity": {
      "enabled": true
    }
  },
  "logging": {
    "level": "INFO",
    "file": "dashboard.log"
  }
}
